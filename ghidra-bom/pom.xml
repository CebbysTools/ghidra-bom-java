<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lv.cebbys.tools</groupId>
        <artifactId>ghidra-bom-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ghidra-bom</artifactId>
    <packaging>pom</packaging>
    <description>Bill of Materials for Ghidra dependencies</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-ghidra-home-path</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>ghidra-home.path</property>
                                    <message>
                                        ========================================
                                        ERROR: ghidra-home.path is not defined!
                                        ========================================

                                        The 'ghidra-home.path' property must be defined when using ghidra-bom.

                                        Please define it in one of the following ways:

                                        1. In your project's pom.xml:
                                           &lt;properties&gt;
                                               &lt;ghidra-home.path&gt;/path/to/ghidra&lt;/ghidra-home.path&gt;
                                           &lt;/properties&gt;

                                        2. As a Maven command line property:
                                           mvn clean install -Dghidra-home.path=/path/to/ghidra

                                        3. In your Maven settings.xml (~/.m2/settings.xml):
                                           &lt;properties&gt;
                                               &lt;ghidra-home.path&gt;/path/to/ghidra&lt;/ghidra-home.path&gt;
                                           &lt;/properties&gt;

                                        ========================================
                                    </message>
                                </requireProperty>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ghidra</id>
            <activation>
                <property>
                    <name>ghidra.version</name>
                </property>
            </activation>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>ghidra</groupId>
                        <artifactId>configurations</artifactId>
                        <version>${ghidra.version}</version>
                        <scope>system</scope>
                        <systemPath>${ghidra-home.path}/Ghidra/Configurations/Public_Release/lib/Public_Release.jar</systemPath>
                    </dependency>
                </dependencies>
            </dependencyManagement>
        </profile>
    </profiles>
</project>
